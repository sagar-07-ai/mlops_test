FROM python:3.12.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /workspace

COPY requirements.txt requirements-dev.txt ./
RUN python -m pip install --requirement requirements-dev.txt \
    && python -m pip check

RUN groupadd --gid 10001 test \
    && useradd --uid 10001 --gid test --no-create-home --shell /usr/sbin/nologin test \
    && mkdir -p /workspace/test-results \
    && chown test:test /workspace/test-results

COPY --chown=test:test app/ ./app/
COPY --chown=test:test tests/ ./tests/
COPY --chown=test:test pytest.ini ./

USER 10001:10001

CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "-v", "--junitxml=test-results/pytest.xml"]
